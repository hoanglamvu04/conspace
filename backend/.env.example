# Runtime: do not commit the real backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=5088

# PostgreSQL 16.15 on existing VPS, isolated conspace database.
# Replace user/password with the dedicated role credentials.
DATABASE_URL=postgresql://conspace_app:REPLACE_WITH_REAL_SECRET@127.0.0.1:5432/conspace

# For direct local development; production frontend/API share one origin.
CORS_ORIGIN=http://127.0.0.1:5176,http://localhost:5176
