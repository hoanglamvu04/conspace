# Never commit backend/.env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=5088

# Dedicated CONSPACE PostgreSQL 16 database and role only.
DATABASE_URL=postgresql://conspace_app:REPLACE_WITH_REAL_SECRET@127.0.0.1:5432/conspace

# Same-origin web/API deployment. Include local Vite origins for development.
PUBLIC_ORIGIN=http://127.0.0.1:5176
CORS_ORIGIN=http://127.0.0.1:5176,http://localhost:5176

# CMS sessions expire after this many hours.
SESSION_TTL_HOURS=8

# Private Q&A contact data is encrypted with AES-256-GCM.
# Generate a unique key with: openssl rand -hex 32
# Leave empty to disable the optional private-reply phone field.
CONTACT_ENCRYPTION_KEY=

# Files are stored outside Git under backend/uploads by default.
MEDIA_STORAGE_DIR=./uploads
