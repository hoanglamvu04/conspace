# Public deployment targets only. No passwords, tokens, or secrets in git.
CONSPACE_DOMAIN=conspace.vn
CONSPACE_WWW_DOMAIN=www.conspace.vn
CONSPACE_VPS_IP=103.149.170.146
CONSPACE_DIR=/var/www/conspace
CONSPACE_DB_NAME=conspace
CONSPACE_DB_USER=conspace_app
CONSPACE_DB_PORT=5432
CONSPACE_API_BIND=127.0.0.1
CONSPACE_API_PORT=5088

# Confirm Nginx worker group from /etc/nginx/nginx.conf before setup.
NGINX_GROUP=www-data
MEDIA_ROOT=/var/lib/conspace/media
MEDIA_PUBLIC_URL_PREFIX=/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_PDF_BYTES=26214400
CONSPACE_BACKUP_ROOT=/var/backups/conspace
CONSPACE_BACKUP_RETENTION_DAYS=14
NODE_ENV=production
